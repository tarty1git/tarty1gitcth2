# Copy to .env and edit. setup.sh creates .env for you on the first run.

# Models to download, separated by spaces. Browse: https://ollama.com/library
# CPU or 8 GB GPU: 7-8B models. 16-24 GB VRAM: 14B models.
MODELS=qwen2.5:7b

# Where Open WebUI listens. 127.0.0.1 = this machine only (reach it via SSH tunnel,
# Caddy or a VPN). 0.0.0.0 = every network interface.
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000

# HTTPS with the built-in Caddy: uncomment both and point the domain's DNS here.
#COMPOSE_PROFILES=https
#DOMAIN=ai.yourdomain.com

# GPU: uncomment one (setup.sh sets the NVIDIA one automatically when it works).
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.amd.yml

# Pin versions instead of always taking the newest.
#OLLAMA_VERSION=latest
#WEBUI_VERSION=main

# How long a model stays in memory after the last request (e.g. 5m, 1h, -1 = forever).
#OLLAMA_KEEP_ALIVE=5m
